{
  "name": "ot-core",
  "version": "1.5.0",
  "description": "Operational Transform for plain text: the algebra, a client state machine, a server, and a transport — with convergence actually tested.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js"
    },
    "./client": {
      "types": "./client.d.ts",
      "import": "./src/client.js"
    },
    "./server": {
      "types": "./server.d.ts",
      "import": "./src/server.js"
    },
    "./protocol": {
      "types": "./protocol.d.ts",
      "import": "./src/protocol.js"
    },
    "./websocket": {
      "types": "./websocket.d.ts",
      "import": "./src/websocket.js"
    },
    "./codemirror": {
      "types": "./codemirror.d.ts",
      "import": "./src/codemirror.js"
    },
    "./presence": {
      "types": "./presence.d.ts",
      "import": "./src/presence.js"
    },
    "./undo": {
      "types": "./undo.d.ts",
      "import": "./src/undo.js"
    },
    "./codemirror5": {
      "types": "./codemirror5.d.ts",
      "import": "./src/codemirror5.js"
    },
    "./fuzz": {
      "types": "./fuzz.d.ts",
      "import": "./src/fuzz.js"
    }
  },
  "types": "./index.d.ts",
  "files": [
    "src",
    "*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "bench": "node bench/transform.bench.js && node bench/session.bench.js",
    "demo": "node demo/serve.js"
  },
  "keywords": [
    "codemirror",
    "collaborative-editing",
    "convergence",
    "crdt",
    "operational-transform",
    "ot",
    "realtime"
  ],
  "license": "MIT",
  "author": "Yuvraj Singh Nain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuvrajinbhakti/ot-core.git"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "bugs": {
    "url": "https://github.com/yuvrajinbhakti/ot-core/issues"
  },
  "homepage": "https://github.com/yuvrajinbhakti/ot-core#readme",
  "devDependencies": {
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "codemirror": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "codemirror": {
      "optional": true
    }
  }
}
